// Lantern Forms — data model (forms hub + roster).
//
// Azure SQL (SQL Server). Local development runs SQL Server in a container
// (README "Database"). No enums, scalar lists or Json columns: statuses are
// strings and structured blobs are JSON text.
//
// Every string column has an explicit size. Ids are 64; anything that can hold
// free text, JSON or a URL is MAX; the rest 255, so every index stays under
// SQL Server's 1,700-byte key limit. NVARCHAR(MAX) can't be in an index.
//
// Schema changes are migrations (prisma/migrations): `npx prisma migrate dev
// --name <what>` locally; production runs `prisma migrate deploy`
// (RUN_MIGRATIONS=true, see docker-entrypoint.sh).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Sites ─────────────────────────

/// A Lantern property / shelter site. Every roster entry belongs to one.
model Site {
  id             String  @id @default(cuid()) @db.NVarChar(64)
  /// Stable, URL-safe code used by the public API and WordPress
  /// (e.g. "amber-hall"). Never changes once integrations depend on it.
  code           String  @unique @db.NVarChar(255)
  /// Display name staff see ("Amber Hall").
  name           String  @db.NVarChar(255)
  /// Legal/ownership entity as it appears in property-management exports
  /// ("Amber Hall LP"). The CSV importer matches on this.
  /// Unique in practice (enforced in code) — not a DB unique index, because
  /// SQL Server permits only one NULL in a unique index.
  entityName     String? @db.NVarChar(255)
  /// "shelter" sites turn over fast; "supportive" housing is stable. Code forms
  /// read it (Hot Foods: shelters get more meals a day, with a cooldown).
  /// Anything but "shelter" counts as supportive.
  siteType       String  @default("supportive") @db.NVarChar(255)
  address        String? @db.NVarChar(Max)
  /// Where the building is (WGS84). Forms use it to pick the site a staff
  /// member is standing at; their position is compared on the device and never
  /// sent to the server. Both null = no location on file.
  latitude       Float?
  longitude      Float?
  /// How close counts as "at this site", in metres. Null = the default (200).
  geofenceMeters Int?
  active         Boolean @default(true)
  /// Per-site override of the attention threshold, in hours. Null = org default.
  attentionHours Int?

  tenants          Tenant[]
  userSites        UserSite[]
  apiKeys          ApiKey[]
  attendanceEvents AttendanceEvent[]
  calendarEvents   CalendarEventSite[]
  calendarFollows  CalendarFollow[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entityName])
}

// ───────────────────────── Roster ─────────────────────────

/// One person on a site's roster. The id is the permanent roster ID: forms,
/// WordPress and the activity log all reference it, never the name — so a
/// spelling fix or a preferred-name change can't create a false "inactive".
model Tenant {
  id            String    @id @default(cuid()) @db.NVarChar(64)
  site          Site      @relation(fields: [siteId], references: [id])
  siteId        String    @db.NVarChar(64)
  unit          String?   @db.NVarChar(255)
  firstName     String    @db.NVarChar(255)
  lastName      String    @default("") @db.NVarChar(255)
  /// What staff call them ("Inez"). Shown first when present.
  preferredName String?   @db.NVarChar(255)
  /// "active" | "archived". Removing someone archives them; nothing in the
  /// app hard-deletes a roster entry.
  status        String    @default("active") @db.NVarChar(255)
  moveInDate    DateTime?
  moveOutDate   DateTime?
  notes         String?   @db.NVarChar(Max)
  /// Identifier in an upstream system (Yardi, property-management export…).
  externalId    String?   @db.NVarChar(255)

  // ── Activity / attention ────────────────────────────────
  /// Last time any designated form or integration referenced this person.
  lastActivityAt     DateTime?
  lastActivitySource String?   @db.NVarChar(255)
  /// Last time a staff member swiped "keep" in the review queue.
  lastKeptAt         DateTime?
  lastKeptById       String?   @db.NVarChar(64)
  /// max(createdAt, lastActivityAt, lastKeptAt) — denormalised so the
  /// attention queue is one indexed range scan instead of a computed filter.
  /// Maintained by services/roster.ts; never write it directly.
  attentionClockAt   DateTime  @default(now())

  // ── Archive ────────────────────────────────────────────
  archivedAt    DateTime?
  archivedById  String?   @db.NVarChar(64)
  archiveReason String?   @db.NVarChar(Max)

  /// Optimistic concurrency: every write must present the version it read.
  version     Int      @default(1)
  createdById String?  @db.NVarChar(64)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  activities        TenantActivity[]
  audit             AuditEvent[]
  attendanceEntries AttendanceEntry[]

  @@index([siteId, status, attentionClockAt])
  @@index([siteId, status, unit])
  @@index([updatedAt])
  @@index([lastName, firstName])
}

/// A signal that a tenant is still around: a form submission that named them,
/// an integration ping, or a manual "seen today". Append-only.
model TenantActivity {
  id          String   @id @default(cuid()) @db.NVarChar(64)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId    String   @db.NVarChar(64)
  /// Machine source: "gravity_forms" | "roster" | "api" | "import".
  source      String   @db.NVarChar(255)
  /// Human label: "Incident Report (form 12)".
  label       String?  @db.NVarChar(Max)
  /// Source-side id (e.g. GF entry id). With `source`, makes a retried
  /// webhook idempotent — checked in code, not by a unique constraint,
  /// because SQL Server allows only one NULL in a unique index.
  externalRef String?  @db.NVarChar(255)
  occurredAt  DateTime
  /// Who/what recorded it — a person's name or an API key's name.
  recordedBy  String?  @db.NVarChar(255)
  createdAt   DateTime @default(now())

  @@index([source, externalRef])
  @@index([tenantId, occurredAt])
}

/// Immutable record of who changed a roster and why.
model AuditEvent {
  id        String   @id @default(cuid()) @db.NVarChar(64)
  actorId   String?  @db.NVarChar(64)
  actorName String   @db.NVarChar(255)
  /// tenant.created | tenant.updated | tenant.archived | tenant.restored |
  /// tenant.kept | site.* | user.* | import.completed | apikey.* | webhook.*
  action    String   @db.NVarChar(255)
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  tenantId  String?  @db.NVarChar(64)
  siteId    String?  @db.NVarChar(64)
  summary   String   @db.NVarChar(Max)
  /// JSON text: { field: [before, after] } or free-form metadata.
  changes   String?  @db.NVarChar(Max)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([siteId, createdAt])
  @@index([tenantId, createdAt])
}

// ───────────────────────── Attendance ─────────────────────────

/// One attendance-taking session at a site: a title, a description, and
/// whoever was marked present. Append-only — nothing here is ever edited;
/// retake it if a mistake is made, the same philosophy as AuditEvent.
model AttendanceEvent {
  id            String   @id @default(cuid()) @db.NVarChar(64)
  site          Site     @relation(fields: [siteId], references: [id])
  siteId        String   @db.NVarChar(64)
  title         String   @db.NVarChar(255)
  description   String   @db.NVarChar(Max)
  /// Always the server's clock at creation — never taken from the client.
  occurredAt    DateTime @default(now())
  createdById   String?  @db.NVarChar(64)
  createdByName String   @db.NVarChar(255)
  createdAt     DateTime @default(now())

  entries AttendanceEntry[]

  @@index([siteId, occurredAt])
}

/// One person's presence at an attendance event, with an optional signature
/// captured on the device at the time.
model AttendanceEntry {
  id         String          @id @default(cuid()) @db.NVarChar(64)
  event      AttendanceEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId    String          @db.NVarChar(64)
  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tenantId   String          @db.NVarChar(64)
  /// Snapshot at signing time — a later name edit shouldn't rewrite history.
  tenantName String          @db.NVarChar(255)
  /// PNG data URL captured on the device; null if not collected.
  signature  String?         @db.NVarChar(Max)
  signedAt   DateTime?
  createdAt  DateTime        @default(now())

  @@unique([eventId, tenantId])
  @@index([tenantId])
}

// ───────────────────────── Calendar ─────────────────────────
// Dates and times are New York wall-clock text ("2026-10-02", "09:30"), not
// instants: a 9:30 meeting stays at 9:30 on every one of its days, either side
// of a clock change, and the repeat rule works on days (src/calendar/recurrence.ts).

/// A kind of event ("Training", "Holiday") and the color it's drawn in.
model CalendarCategory {
  id        String   @id @default(cuid()) @db.NVarChar(64)
  name      String   @db.NVarChar(255)
  /// Slot 0-7 of the chart palette (frontend index.css --viz-1…8), so a
  /// color means the same kind of event on every screen.
  colorSlot Int      @default(0)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events CalendarEvent[]
  mutes  CalendarCategoryMute[]
}

/// A category someone doesn't want in their Outlook ("no trainings, thanks").
model CalendarCategoryMute {
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String           @db.NVarChar(64)
  category   CalendarCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String           @db.NVarChar(64)

  @@id([userId, categoryId])
  @@index([categoryId])
}

/// One event on the calendar, or a whole repeating series of them.
model CalendarEvent {
  id            String            @id @default(cuid()) @db.NVarChar(64)
  title         String            @db.NVarChar(255)
  description   String?           @db.NVarChar(Max)
  location      String?           @db.NVarChar(Max)
  /// Deleting a category leaves its events uncategorized.
  category      CalendarCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId    String?           @db.NVarChar(64)
  /// True: every site sees it. False: only people at the sites in `sites`.
  allSites      Boolean           @default(true)
  allDay        Boolean           @default(false)
  /// The first occurrence as entered. Later ones keep its length and times.
  startDate     String            @db.NVarChar(255)
  /// "HH:MM"; null when all day.
  startTime     String?           @db.NVarChar(255)
  /// The day it ends (the same day, or later for a multi-day event).
  endDate       String            @db.NVarChar(255)
  endTime       String?           @db.NVarChar(255)
  /// JSON text: the repeat rule (src/calendar/recurrence.ts). Null = happens once.
  recurrence    String?           @db.NVarChar(Max)
  /// Give it a Microsoft Teams meeting link when it goes to Outlook. Once
  /// Outlook has made the link it can't be taken away (a Microsoft rule).
  teamsMeeting  Boolean           @default(false)
  /// Waiting on approval in the code form that made it (an event request): shown
  /// on the calendar marked "Needs approval", and kept out of Outlook until approved.
  pending       Boolean           @default(false)
  /// The code form that owns it (server code's ctx.calendar.form). Only that form
  /// changes it; the calendar screens show it read-only with a link back. Deleting
  /// the form leaves the event as an ordinary one.
  sourceForm    BuiltForm?        @relation(fields: [sourceFormId], references: [id], onDelete: SetNull)
  sourceFormId  String?           @db.NVarChar(64)
  /// The form's own reference for it, e.g. the entry id of the request.
  sourceRef     String?           @db.NVarChar(255)
  /// The day it first happens, and the day its last occurrence ends, so a
  /// month's events are an indexed range query. lastDate null = repeats forever.
  firstDate     String            @db.NVarChar(255)
  lastDate      String?           @db.NVarChar(255)
  createdById   String?           @db.NVarChar(64)
  createdByName String            @db.NVarChar(255)
  /// Who changed it last (null: a scheduled action). Their Outlook calendar is
  /// the one that sends it, if it hasn't been sent yet (services/outlookSync.ts).
  updatedById   String?           @db.NVarChar(64)
  updatedByName String?           @db.NVarChar(255)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  sites      CalendarEventSite[]
  exceptions CalendarException[]
  copies     CalendarCopy[]

  // ── Outlook (services/outlookSync.ts) ──
  /// The person whose Outlook calendar holds the meeting (its organizer), once sent.
  outlookOrganizerId String?   @db.NVarChar(64)
  /// The meeting's id in the organizer's calendar, once sent.
  outlookEventId     String?   @db.NVarChar(512)
  /// The Teams join link Outlook made for it.
  teamsJoinUrl       String?   @db.NVarChar(Max)
  /// Changed since Outlook last heard about it; the sync queue picks these up.
  outlookDirty       Boolean   @default(true)
  /// Why the last send failed (or can't happen), in words. Null = fine.
  outlookError       String?   @db.NVarChar(Max)
  outlookSyncedAt    DateTime?
  /// What was last sent, hashed, so an unchanged event isn't sent again.
  outlookHash        String?   @db.NVarChar(255)

  @@index([firstDate])
  @@index([lastDate])
  @@index([sourceFormId, sourceRef])
}

/// A site an event is for, when it isn't for every site.
model CalendarEventSite {
  event   CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String        @db.NVarChar(64)
  site    Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId  String        @db.NVarChar(64)

  @@id([eventId, siteId])
  @@index([siteId])
}

/// A site whose events someone wants as invites in their own Outlook calendar.
model CalendarFollow {
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @db.NVarChar(64)
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId String @db.NVarChar(64)

  @@id([userId, siteId])
  @@index([siteId])
}

/// One person's quiet copy of an event, written straight into their own
/// Outlook calendar (no invite email). See services/outlookSync.ts.
model CalendarCopy {
  id             String        @id @default(cuid()) @db.NVarChar(64)
  event          CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId        String        @db.NVarChar(64)
  userId         String        @db.NVarChar(64)
  /// The mailbox it was written to (their email when it was written).
  mailbox        String        @db.NVarChar(255)
  outlookEventId String?       @db.NVarChar(512)
  /// What was last written, hashed.
  hash           String?       @db.NVarChar(64)
  /// They have no mailbox here (a partner account): they get the invite instead.
  fallbackInvite Boolean       @default(false)
  error          String?       @db.NVarChar(Max)
  updatedAt      DateTime      @updatedAt

  @@unique([eventId, userId])
}

/// An Outlook meeting (or a quiet copy) still to be removed, after its event was
/// deleted here. Removed with its owner's own token; waits until they have one.
model CalendarOutlookTrash {
  id             String   @id @default(cuid()) @db.NVarChar(64)
  /// Whose calendar it's in (User id).
  ownerId        String   @db.NVarChar(64)
  /// True: the organizer's meeting (cancelled, so invitees hear). False: a
  /// quiet copy (just deleted).
  meeting        Boolean
  outlookEventId String   @db.NVarChar(512)
  title          String   @db.NVarChar(255)
  error          String?  @db.NVarChar(Max)
  createdAt      DateTime @default(now())
}

/// One day of a repeating event changed on its own: cancelled, moved, or
/// reworded. Fields left null follow the series.
model CalendarException {
  id            String        @id @default(cuid()) @db.NVarChar(64)
  event         CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId       String        @db.NVarChar(64)
  /// The day the series puts it on, which says which occurrence this is.
  originalDate  String        @db.NVarChar(255)
  cancelled     Boolean       @default(false)
  title         String?       @db.NVarChar(255)
  description   String?       @db.NVarChar(Max)
  location      String?       @db.NVarChar(Max)
  /// Set all together, only when this one was moved or retimed.
  allDay        Boolean?
  startDate     String?       @db.NVarChar(255)
  startTime     String?       @db.NVarChar(255)
  endDate       String?       @db.NVarChar(255)
  endTime       String?       @db.NVarChar(255)
  updatedByName String?       @db.NVarChar(255)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([eventId, originalDate])
  @@index([startDate])
}

// ───────────────────────── Forms hub ─────────────────────────

/// A heading on the Forms screen ("Pantry Forms", "Finance & Cash Handling").
model FormCategory {
  id        String     @id @default(cuid()) @db.NVarChar(64)
  name      String     @db.NVarChar(255)
  /// Icon key from the frontend's fixed set (frontend/src/lib/formIcons.ts).
  icon      String     @default("folder") @db.NVarChar(255)
  sortOrder Int        @default(0)
  forms     FormLink[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

/// One form (or form-like destination) on the Forms screen. Most still live on
/// the WordPress site and are plain links; as a form is rebuilt inside this app
/// its `url` becomes an app path ("/roster") and nothing else changes.
model FormLink {
  id          String         @id @default(cuid()) @db.NVarChar(64)
  /// No cascade: a category must be emptied before it can be deleted.
  category    FormCategory   @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  categoryId  String         @db.NVarChar(64)
  title       String         @db.NVarChar(255)
  description String?        @db.NVarChar(Max)
  /// An absolute http(s) URL (a form still on WordPress), or an app path
  /// starting with "/" (a screen built into this site).
  url         String         @db.NVarChar(Max)
  /// Extra words search should match, comma-separated ("tenant updater, move in").
  keywords    String?        @db.NVarChar(Max)
  /// Short tag shown on the card ("New", "Password required").
  badge       String?        @db.NVarChar(255)
  /// Icon key (frontend lib/formIcons.ts), shown on the card and in the
  /// collapsed sidebar. Null = the category's icon.
  icon        String?        @db.NVarChar(255)
  sortOrder   Int            @default(0)
  /// Hidden from staff when false; admins still see it in the catalog editor.
  active      Boolean        @default(true)
  /// Comma-separated role keys that may see this form ("site_admin,site_manager").
  /// Null = every role. Admins always see every form.
  roles       String?        @db.NVarChar(255)
  favorites   FormFavorite[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([categoryId, sortOrder])
}

/// A form someone starred, so it sits at the top of their Forms screen on
/// every device they sign in on.
model FormFavorite {
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @db.NVarChar(64)
  form      FormLink @relation(fields: [formId], references: [id], onDelete: Cascade)
  formId    String   @db.NVarChar(64)
  createdAt DateTime @default(now())

  @@id([userId, formId])
  @@index([formId])
}

// ───────────────────────── Form builder ─────────────────────────

/// A form built in Admin → Form builder (or from code, an import, or the MCP
/// server). The whole definition is one JSON document in the lcs-form format
/// (backend/src/forms/schema.ts), so what the builder, the code editor, an
/// export file and an LLM see is exactly the same thing.
model BuiltForm {
  id            String    @id @default(cuid()) @db.NVarChar(64)
  /// "basic" (drag-and-drop lcs-form document) | "code" (a code form: a small
  /// project of files — pages, server logic, styles; see backend/src/apps/).
  kind          String    @default("basic") @db.NVarChar(255)
  /// URL name: the form opens at /f/<slug>. Unique; changing it breaks links.
  slug          String    @unique @db.NVarChar(255)
  title         String    @db.NVarChar(255)
  /// "draft" (never published) | "published" | "closed" (published, not taking
  /// entries) | "archived" (hidden everywhere, entries kept).
  status        String    @default("draft") @db.NVarChar(255)
  /// The working copy the builder edits. JSON text: an lcs-form document, or for
  /// a code form { files: { path: source } }.
  draftSchema   String    @db.NVarChar(Max)
  /// What people actually fill in. Null until first published. For a code form,
  /// { files, build } — the published sources and their compiled output.
  liveSchema    String?   @db.NVarChar(Max)
  /// Bumped on every publish; entries record the version they were filled against.
  liveVersion   Int       @default(0)
  /// Bumped on every draft save — the editor sends back the revision it loaded,
  /// so two admins (or an admin and an LLM) can't silently overwrite each other.
  revision      Int       @default(1)
  /// Catalog card that opens this form, when it's been added to Forms.
  catalogLinkId String?   @db.NVarChar(64)
  /// A code form whose published form.json has "home": its server action adds
  /// cards to the Forms home. Kept as a column so the home screen needn't open every form.
  homeAction    Boolean   @default(false)
  createdById   String?   @db.NVarChar(64)
  createdByName String    @db.NVarChar(255)
  updatedByName String?   @db.NVarChar(255)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  versions       BuiltFormVersion[]
  entries        FormEntry[]
  files          FormFile[]
  records        FormRecord[]
  calendarEvents CalendarEvent[]
  FormJob        FormJob[]

  @@index([status])
}

/// Snapshot of a form each time it was published, so an entry can always be
/// shown with the labels and choices it was filled in against, and an older
/// version can be restored into the draft.
model BuiltFormVersion {
  id              String    @id @default(cuid()) @db.NVarChar(64)
  form            BuiltForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  formId          String    @db.NVarChar(64)
  version         Int
  schema          String    @db.NVarChar(Max)
  note            String?   @db.NVarChar(Max)
  publishedByName String    @db.NVarChar(255)
  createdAt       DateTime  @default(now())

  @@unique([formId, version])
}

/// One submission of a built form. Values are JSON keyed by field id.
model FormEntry {
  id             String    @id @default(cuid()) @db.NVarChar(64)
  form           BuiltForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  formId         String    @db.NVarChar(64)
  formVersion    Int
  /// JSON text: { [fieldId]: value }. Only fields that were visible are kept.
  data           String    @db.NVarChar(Max)
  /// The site the entry was made for, when the form asks for one — entries are
  /// then limited to people assigned to that site, like the rest of the app.
  siteId         String?   @db.NVarChar(64)
  /// "app" | "public" | "api" | "mcp" | "import"
  source         String    @default("app") @db.NVarChar(255)
  /// "active" | "voided"
  status         String    @default("active") @db.NVarChar(255)
  /// When it happened (a code form may record offline and upload later);
  /// defaults to when it was saved.
  occurredAt     DateTime  @default(now())
  /// Roster id of the resident the entry is about, when there is one — indexed
  /// so code forms can ask "this resident's entries today" cheaply.
  tenantId       String?   @db.NVarChar(64)
  /// Why a code form's rule (a limit, a cooldown) was overridden.
  overrideReason String?   @db.NVarChar(Max)
  /// Idempotency key from the filling device, so a retried submit can't save twice.
  /// Unique per form, enforced by the database: two uploads of the same entry
  /// that race past the duplicate check can't both be saved. Entries sent
  /// without one (imports, the MCP server) get a generated one, since SQL
  /// Server's unique index counts NULLs as equal.
  clientId       String    @default(cuid()) @db.NVarChar(255)
  createdById    String?   @db.NVarChar(64)
  createdByName  String    @db.NVarChar(255)
  ip             String?   @db.NVarChar(64)
  userAgent      String?   @db.NVarChar(512)
  voidedAt       DateTime?
  voidedByName   String?   @db.NVarChar(255)
  voidReason     String?   @db.NVarChar(Max)
  /// Starred by an entry viewer (Gravity Forms' star), for follow-up.
  starred        Boolean   @default(false)
  updatedByName  String?   @db.NVarChar(255)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  notes FormEntryNote[]
  files FormFile[]

  @@index([formId, createdAt])
  @@index([formId, status])
  @@index([formId, occurredAt])
  @@index([formId, tenantId, occurredAt])
  @@unique([formId, clientId])
  @@index([siteId])
}

/// A note on an entry — typed by a person, or written by the system
/// (notification sent, entry edited, voided).
model FormEntryNote {
  id         String    @id @default(cuid()) @db.NVarChar(64)
  entry      FormEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  entryId    String    @db.NVarChar(64)
  /// "note" | "system"
  kind       String    @default("note") @db.NVarChar(255)
  authorName String    @db.NVarChar(255)
  body       String    @db.NVarChar(Max)
  createdAt  DateTime  @default(now())

  @@index([entryId, createdAt])
}

/// A file uploaded through a File field or a code form (photos, signatures).
/// The bytes are in Azure Blob Storage (storageKey) when it's configured, or in
/// `data` otherwise (local development). See services/fileStore.ts.
model FormFile {
  id          String     @id @default(cuid()) @db.NVarChar(64)
  form        BuiltForm  @relation(fields: [formId], references: [id], onDelete: Cascade)
  formId      String     @db.NVarChar(64)
  /// Null while uploaded but not yet submitted; orphans older than a day are swept.
  entry       FormEntry? @relation(fields: [entryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  entryId     String?    @db.NVarChar(64)
  /// The File field's id; for a code form, the page's own label for the file ("photo").
  fieldId     String     @db.NVarChar(255)
  name        String     @db.NVarChar(255)
  mime        String     @db.NVarChar(255)
  size        Int
  /// The bytes, when they're kept in the database.
  data        Bytes?
  /// The blob's name in the files container, when they're in Blob Storage.
  storageKey  String?    @db.NVarChar(512)
  /// Who uploaded it. A code form's file that isn't on an entry yet can only be
  /// read back (or attached) by the person who uploaded it.
  createdById String?    @db.NVarChar(64)
  createdAt   DateTime   @default(now())

  @@index([entryId])
  @@index([formId, createdAt])
}

/// A code form's own data besides entries: lists admins edit (meal types),
/// settings, anything the form's pages or server code keep. One JSON document
/// per (form, collection, docId).
model FormRecord {
  id            String    @id @default(cuid()) @db.NVarChar(64)
  form          BuiltForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  formId        String    @db.NVarChar(64)
  collection    String    @db.NVarChar(255)
  docId         String    @db.NVarChar(255)
  data          String    @db.NVarChar(Max)
  updatedByName String?   @db.NVarChar(255)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([formId, collection, docId])
  @@index([formId, collection])
}

// ───────────────────────── People ─────────────────────────

model User {
  id                        String                 @id @default(cuid()) @db.NVarChar(64)
  name                      String                 @db.NVarChar(255)
  email                     String                 @unique @db.NVarChar(255)
  /// Entra object id — stable identity behind the mailbox, recorded on first
  /// sign-in. Google Workspace users signing in as Entra B2B guests get one
  /// too, so the same matching works for both. Indexed, not unique: invited
  /// users have none yet, and SQL Server allows only one NULL per unique index.
  entraObjectId             String?                @db.NVarChar(64)
  /// "microsoft" | "google.com" | other federated idp claim. Informational.
  identityProvider          String?                @db.NVarChar(255)
  /// admin | main_office | site_admin | site_manager | site_staff — see services/permissions.ts.
  roleKey                   String                 @default("site_staff") @db.NVarChar(255)
  /// active | invited | requested | denied | deactivated
  status                    String                 @default("active") @db.NVarChar(255)
  title                     String?                @db.NVarChar(255)
  avatarColor               String?                @db.NVarChar(255)
  defaultLandingPage        String                 @default("/forms") @db.NVarChar(Max)
  /// Site code the roster opens on. Null = first site they can see.
  defaultSiteCode           String?                @db.NVarChar(255)
  /// Can add, change and remove calendar events for their own sites, whatever
  /// their role. Only an Admin turns it on. Admins can always edit the calendar.
  calendarEditor            Boolean                @default(false)
  /// A Super Admin (the column keeps its first name, Global Admin): an Admin who
  /// can also make, change and remove Admins (admins.manage). Only on with
  /// roleKey "admin". Set only from the SUPER_ADMINS setting, at start-up and at
  /// sign-in (services/superAdmins.ts); the app and the API never change it.
  globalAdmin               Boolean                @default(false)
  /// Outlook invites: every-site events too. Set in the calendar's "Add to my
  /// Outlook" popup, along with the sites in CalendarFollow.
  calendarSyncEverySite     Boolean                @default(false)
  /// When they last answered that popup. Null = never asked yet.
  calendarSyncSetAt         DateTime?
  /// How events reach their Outlook: an invite (with an email) or a quiet copy
  /// written straight into their calendar (no email). Teams meetings default
  /// to invites, everything else to quiet copies.
  calendarEmailTeams        Boolean                @default(true)
  calendarEmailOther        Boolean                @default(false)
  /// Reminder on quiet copies, in minutes before. Null = no reminder.
  calendarReminderMinutes   Int?                   @default(15)
  /// Quiet copies of all-day events show as free rather than busy.
  calendarAllDayFree        Boolean                @default(true)
  /// Leave events with no category out of their Outlook. Categories they left
  /// out are in CalendarCategoryMute (so a new category is in by default).
  calendarSkipUncategorized Boolean                @default(false)
  calendarMutes             CalendarCategoryMute[]
  lastSignInAt              DateTime?

  /// Sites this person may act on. Empty = all sites (admins always all).
  sites           UserSite[]
  formFavorites   FormFavorite[]
  calendarFollows CalendarFollow[]
  graphToken      UserGraphToken?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entraObjectId])
}

/// A person's Microsoft Graph refresh token from their last Microsoft sign-in
/// (delegated Calendars.ReadWrite + offline_access), so the calendar can write
/// to their own Outlook when they aren't on the site. Encrypted at rest
/// (services/graphTokens.ts), never sent to a browser, and deleted when they
/// sign out or lose access.
model UserGraphToken {
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String   @id @db.NVarChar(64)
  /// AES-256-GCM with TOKEN_ENCRYPTION_KEY: "v1.<iv>.<tag>.<ciphertext>", base64url.
  refreshToken String   @db.NVarChar(Max)
  /// The scopes Microsoft granted, space-separated.
  scopes       String   @db.NVarChar(Max)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model UserSite {
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @db.NVarChar(64)
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId String @db.NVarChar(64)

  @@id([userId, siteId])
}

// ───────────────────────── Integrations ─────────────────────────

/// Machine credential for WordPress / Power Automate. Only a hash is stored.
model ApiKey {
  id          String    @id @default(cuid()) @db.NVarChar(64)
  name        String    @db.NVarChar(255)
  /// First characters of the key, shown so people can tell keys apart.
  prefix      String    @db.NVarChar(255)
  hash        String    @unique @db.NVarChar(64)
  /// Comma-separated: "roster:read,activity:write".
  scopes      String    @db.NVarChar(Max)
  /// Optional restriction to one site.
  site        Site?     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId      String?   @db.NVarChar(64)
  lastUsedAt  DateTime?
  createdById String?   @db.NVarChar(64)
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
}

/// Outbound webhook: roster changes are POSTed here, HMAC-signed.
model Webhook {
  id             String    @id @default(cuid()) @db.NVarChar(64)
  name           String    @db.NVarChar(255)
  url            String    @db.NVarChar(Max)
  secret         String    @db.NVarChar(255)
  /// Comma-separated event names, or "*" for everything.
  events         String    @default("*") @db.NVarChar(Max)
  active         Boolean   @default(true)
  lastDeliveryAt DateTime?
  lastStatus     Int?
  lastError      String?   @db.NVarChar(Max)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  deliveries WebhookDelivery[]
}

model WebhookDelivery {
  id         String   @id @default(cuid()) @db.NVarChar(64)
  webhook    Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  webhookId  String   @db.NVarChar(64)
  event      String   @db.NVarChar(255)
  statusCode Int?
  error      String?  @db.NVarChar(Max)
  durationMs Int?
  createdAt  DateTime @default(now())

  @@index([webhookId, createdAt])
}

/// Org-wide key/value settings (attention threshold, guest domains…).
model Setting {
  key       String   @id @db.NVarChar(255)
  value     String   @db.NVarChar(Max)
  updatedAt DateTime @updatedAt
}

/// An entry one code form's server code asked to be made in another form
/// (ctx.db.form(slug).entries.create) — e.g. an encounter's bundled Hot Foods
/// meals. Queued, then saved through the other form's own rules, as the person
/// who caused it, by services in apps/jobs.ts. Kept as the record of what was
/// made from what; a failed one can be retried.
model FormJob {
  id            String    @id @default(cuid()) @db.NVarChar(64)
  /// The form whose server code asked.
  form          BuiltForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  formId        String    @db.NVarChar(64)
  /// The source form's entry it belongs to (e.g. the encounter), if any.
  sourceEntryId String?   @db.NVarChar(64)
  /// The form the entry goes into.
  targetSlug    String    @db.NVarChar(255)
  /// JSON text: { data, site, tenantId, occurredAt, override, label }.
  input         String    @db.NVarChar(Max)
  /// Whose request it was; null = scheduled or an API key.
  userId        String?   @db.NVarChar(64)
  userName      String    @db.NVarChar(255)
  /// "queued" | "running" | "done" | "failed"
  status        String    @default("queued") @db.NVarChar(255)
  error         String?   @db.NVarChar(Max)
  /// The entry made in the target form.
  resultEntryId String?   @db.NVarChar(64)
  attempts      Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([formId, sourceEntryId])
}

// ───────────────────────── Dev log ─────────────────────────
//
// Admin → Dev log (services/devlog.ts): how the running site is doing, kept
// DEVLOG_RETENTION_DAYS (30 by default). Rolled up in memory and written once
// a minute, so the log costs a handful of writes a minute, not one a request.

/// One minute of calls to one API route ("route"), or of every database query
/// ("db"), on one server. h0…h10 count calls by duration (DURATION_BOUNDS in
/// services/devlog.ts), so percentiles add up across minutes and servers.
model DevMetric {
  id       String   @id @default(cuid()) @db.NVarChar(64)
  /// The minute, to the minute.
  at       DateTime
  /// Which server (App Service instance, or the host name).
  instance String   @db.NVarChar(255)
  /// "route" | "db"
  kind     String   @db.NVarChar(64)
  /// "GET /api/tenants/:id" for a route; "" for db.
  name     String   @db.NVarChar(255)
  calls    Int      @default(0)
  /// 5xx answers.
  errors   Int      @default(0)
  /// 4xx answers (refusals, validation, not found).
  rejected Int      @default(0)
  totalMs  Float    @default(0)
  maxMs    Float    @default(0)
  h0       Int      @default(0)
  h1       Int      @default(0)
  h2       Int      @default(0)
  h3       Int      @default(0)
  h4       Int      @default(0)
  h5       Int      @default(0)
  h6       Int      @default(0)
  h7       Int      @default(0)
  h8       Int      @default(0)
  h9       Int      @default(0)
  h10      Int      @default(0)

  @@index([kind, at])
  @@index([at])
}

/// One minute of one server process: memory, CPU, event-loop delay.
model DevSample {
  id          String   @id @default(cuid()) @db.NVarChar(64)
  at          DateTime
  instance    String   @db.NVarChar(255)
  rssMb       Float
  heapUsedMb  Float
  heapTotalMb Float
  /// Share of one CPU core this process used over the minute (can pass 100).
  cpuPct      Float
  /// How late timers ran: a busy event loop makes every request wait.
  loopP50Ms   Float
  loopP99Ms   Float
  loopMaxMs   Float
  /// Most requests in progress at once during the minute.
  inFlightMax Int
  uptimeSec   Int

  @@index([at])
}

/// Something to look at one at a time: a server error or log line, a slow
/// request or query, a server start, a browser error, a page load's timings,
/// a slow tap.
model DevEvent {
  id         String   @id @default(cuid()) @db.NVarChar(64)
  createdAt  DateTime @default(now())
  /// "error" | "log" | "slow-request" | "slow-query" | "boot"
  /// | "client-error" | "page-load" | "slow-interaction" | "slow-api"
  kind       String   @db.NVarChar(64)
  /// "error" | "warn" | "info"
  level      String   @default("info") @db.NVarChar(16)
  instance   String?  @db.NVarChar(255)
  /// The route or page.
  path       String?  @db.NVarChar(255)
  status     Int?
  durationMs Float?
  message    String?  @db.NVarChar(Max)
  /// JSON text: stack, timings, device, the query…
  data       String?  @db.NVarChar(Max)
  requestId  String?  @db.NVarChar(64)
  userEmail  String?  @db.NVarChar(255)

  @@index([createdAt])
  @@index([kind, createdAt])
}

# ─────────────────────────────────────────────────────────────
# Lantern Forms — backend environment. Copy to .env; secrets in .env.local.
# ─────────────────────────────────────────────────────────────

# Local prototype: SQLite file. Azure SQL (after switching provider — README):
# DATABASE_URL="sqlserver://<server>.database.windows.net:1433;database=lantern-roster;user=<user>;password=<pw>;encrypt=true"
DATABASE_URL="file:./dev.db"

PORT=4200
CORS_ORIGIN="http://localhost:5200"
JWT_SECRET="generate-a-long-random-string"

# Local-only demo sign-in. Ignored (always off) when NODE_ENV=production.
DEV_AUTH=true

# ── Microsoft Entra ID sign-in ───────────────────────────────
# App registration (single tenant), platform "Web", redirect URI:
#   http://localhost:5200/api/auth/microsoft/callback    (local)
#   https://<host>/api/auth/microsoft/callback            (prod)
# Google Workspace staff: add Google as an External Identity in Entra and
# invite them as B2B guests — no change to this app's config. See README.
MICROSOFT_TENANT_ID=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
# MICROSOFT_REDIRECT_URI="http://localhost:5200/api/auth/microsoft/callback"
# APP_BASE_URL="http://localhost:5200"

# Always-allowed email domains. Partner domains are added in the app
# (Admin → Sign-in access) and unioned with this list.
SSO_ALLOWED_DOMAINS="lanterncommunity.org"

# Mailbox that form notification emails are sent from (Microsoft Graph, app-only).
# Needs the Mail.Send application permission on the Entra app. Empty = emails are
# noted on each entry but not sent.
# MAIL_FROM="forms@lanterncommunity.org"

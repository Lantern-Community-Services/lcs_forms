{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "typeRoots": [
      "../../frontend/node_modules/@types"
    ],
    "paths": {
      "react": [
        "../../frontend/node_modules/@types/react"
      ],
      "react/*": [
        "../../frontend/node_modules/@types/react/*"
      ],
      "lucide-react": [
        "../../frontend/node_modules/lucide-react"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}

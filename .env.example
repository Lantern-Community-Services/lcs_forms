# Lantern Forms — docker compose settings. Copy to .env (git-ignored).
# This file is for `docker compose`; running with `npm run dev` uses backend/.env.
# In Azure the same settings are App Service app settings, secrets from Key Vault.

# Required. The local SQL Server's sa password (8+ characters: upper, lower, digit, symbol).
MSSQL_SA_PASSWORD=

# Required. Long random string, e.g.  openssl rand -base64 48
JWT_SECRET=

# Encrypts people's Microsoft refresh tokens in the database (Outlook calendar).
# 32 random bytes:  openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Public address people open the site at. Also the CORS origin and the base for sign-in redirects.
APP_BASE_URL=http://localhost:5200

# Host port for the site (the container always listens on 5200). Change it if 5200 is taken;
# then update APP_BASE_URL and MICROSOFT_REDIRECT_URI to match.
# FRONTEND_PORT=5200

# Microsoft Entra sign-in: the Dev app registration locally. Its redirect URI must match.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:5200/api/auth/microsoft/callback
SSO_ALLOWED_DOMAINS=lanterncommunity.org

# Local smoke test without Entra: NODE_ENV=development and DEV_AUTH=true give the
# demo "Prototype sign-in". Never in production (it is refused there regardless).
# NODE_ENV=development
# DEV_AUTH=true

# The database is the compose SQL Server (service "db").
# (DATABASE_URL is set in docker-compose.yml from MSSQL_SA_PASSWORD; avoid { } in the password.)

# Mailbox form notifications are sent from (see backend/.env.example). Optional.
MAIL_FROM=

# The calendar in people's own Outlook (delegated Calendars.ReadWrite). false = off, and
# sign-in doesn't ask for the calendar scopes.
# OUTLOOK_SYNC=true

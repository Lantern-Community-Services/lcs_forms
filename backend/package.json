{
  "name": "lantern-forms-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Lantern Forms — backend API (Express + Prisma)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:copy-sqlite": "tsx scripts/copy-sqlite.ts",
    "files:to-blob": "tsx scripts/files-to-blob.ts",
    "seed": "tsx prisma/seed.ts",
    "import:tenants": "tsx scripts/import-tenants.ts",
    "sync:engine": "node scripts/sync-engine.mjs",
    "check:engine": "node scripts/sync-engine.mjs --check",
    "forms": "tsx scripts/forms.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@azure/identity": "^4.13.3",
    "@azure/msal-node": "^5.6.0",
    "@azure/storage-blob": "^12.34.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@prisma/client": "^5.22.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.7",
    "esbuild": "^0.28.2",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.20.2",
    "postcss": "^8.5.28",
    "quickjs-emscripten": "^0.32.0",
    "tailwindcss": "^3.4.19",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/pdfkit": "^0.17.6",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "prisma@5.22.0": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true
  }
}

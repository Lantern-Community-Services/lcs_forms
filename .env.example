# Lantern Forms — docker compose settings. Copy to .env (git-ignored).
# This file is for `docker compose`; running with `npm run dev` still uses backend/.env.

# Required. Long random string, e.g.  openssl rand -base64 48
JWT_SECRET=

# Public address people open the site at. Also the CORS origin and the base for sign-in redirects.
APP_BASE_URL=http://localhost:5200

# Host port for the site (the container always listens on 5200). Change it if 5200 is taken;
# then update APP_BASE_URL and MICROSOFT_REDIRECT_URI to match.
# FRONTEND_PORT=5200

# Microsoft Entra sign-in. Redirect URI in the app registration must match MICROSOFT_REDIRECT_URI.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:5200/api/auth/microsoft/callback
SSO_ALLOWED_DOMAINS=lanterncommunity.org

# Local smoke test without Entra: NODE_ENV=development and DEV_AUTH=true give the
# demo "Prototype sign-in". Never in production (it is refused there regardless).
# NODE_ENV=development
# DEV_AUTH=true

# Leave as is for SQLite. For Azure SQL see the README, and set DB_PUSH_ON_START=false
# once you deploy schema changes with `prisma migrate deploy`.
# DATABASE_URL=file:/data/lantern-forms.db
# DB_PUSH_ON_START=true

# Mailbox form notifications are sent from (see backend/.env.example). Optional.
MAIL_FROM=

# ─────────────────────────────────────────────────────────────
# Lantern Forms — backend environment. Copy to .env; secrets in .env.local.
# In Azure these are App Service app settings (secrets from Key Vault).
# ─────────────────────────────────────────────────────────────

# Azure SQL / SQL Server. Locally: `docker compose up -d db` (repo root), then
# `npx prisma migrate dev` creates the database and brings it up to date.
# Wrap the password in { } if it has ; = { } or spaces in it.
DATABASE_URL="sqlserver://localhost:1433;database=lcs_forms;user=sa;password={<MSSQL_SA_PASSWORD>};encrypt=true;trustServerCertificate=true"
# Azure: sqlserver://<server>.database.windows.net:1433;database=<db>;user=<user>;password={<pw>};encrypt=true

PORT=4200
CORS_ORIGIN="http://localhost:5200"
JWT_SECRET="generate-a-long-random-string"

# Proxies between the browser and this process. 1 locally (Next's /api proxy).
# On App Service with the web app proxying /api to the API app: 2.
# TRUST_PROXY=1

# Local-only demo sign-in. Off unless true; always off when NODE_ENV=production or on App Service.
DEV_AUTH=true

# ── Microsoft Entra ID sign-in ───────────────────────────────
# Local development uses the Dev app registration, redirect URI
#   http://localhost:5200/api/auth/microsoft/callback
# Put the three values in .env.local.
MICROSOFT_TENANT_ID=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
# MICROSOFT_REDIRECT_URI="http://localhost:5200/api/auth/microsoft/callback"
# APP_BASE_URL="http://localhost:5200"

# Global Admins: these addresses become active Global Admins when they sign in with
# Microsoft (how a new environment gets its first Admins). Comma-separated.
GLOBAL_ADMINS="cfalkowski@lanterncommunity.org,SPena@lanterncommunity.org"

# Always-allowed email domains. Partner domains are added in the app
# (Admin → Sign-in access) and unioned with this list.
SSO_ALLOWED_DOMAINS="lanterncommunity.org"

# ── The calendar in people's own Outlook ─────────────────────
# Delegated Calendars.ReadWrite + offline_access on the app registration (admin
# consented). Sign-in asks for them and the refresh token is kept, encrypted with
# TOKEN_ENCRYPTION_KEY (32 random bytes, base64: openssl rand -base64 32; required
# in production, derived from JWT_SECRET locally if unset). OUTLOOK_SYNC=false turns
# it off, and then sign-in asks for identity only. See README "Calendar in Outlook".
# TOKEN_ENCRYPTION_KEY=
# OUTLOOK_SYNC=true

# Mailbox that form notification emails are sent from (Microsoft Graph, app-only).
# Needs the Mail.Send application permission on the Entra app. Empty = emails are
# noted on each entry but not sent. Emails are always link-only.
# MAIL_FROM="forms@lanterncommunity.org"

# ── Uploaded files ───────────────────────────────────────────
# Azure Blob Storage, with the app's managed identity (Storage Blob Data Contributor).
# Unset locally: files are kept in the database.
# AZURE_STORAGE_ACCOUNT_URL="https://<account>.blob.core.windows.net"
# AZURE_STORAGE_CONTAINER="form-files"
# Or a connection string (Azurite: UseDevelopmentStorage=true):
# AZURE_STORAGE_CONNECTION_STRING=

# Demo rows (the seed's demo accounts) are refused in production unless this is true.
# ALLOW_DEMO_DATA=false
# The seed backdates some residents into the review queue only with SEED_DEMO_QUEUE=true.
# SEED_DEMO_QUEUE=false

# Backup of every built form (form builder and code forms) to a GitHub repository,
# every 10 minutes when something changed. FORM_BACKUP_TOKEN: a fine-grained token
# with Contents: read and write on that one repository — put it in .env.local.
# See README "Form backup".
# FORM_BACKUP_REPO="Lantern-Community-Services/lcs_forms_form_backup"
# FORM_BACKUP_TOKEN=
# FORM_BACKUP_BRANCH=main
